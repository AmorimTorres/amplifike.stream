<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="MusicStreamer - Sua plataforma de streaming de música" />
    <title>@ViewData["Title"] - MusicStreamer</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body { background-color: #0a0a0f; color: #e0e0e0; font-family: 'Segoe UI', sans-serif; }
        .navbar { background: linear-gradient(135deg, #1a1a2e, #16213e) !important; border-bottom: 1px solid #533483; }
        .navbar-brand { color: #9d4edd !important; font-weight: 700; font-size: 1.4rem; }
        .nav-link { color: #b0b0c0 !important; }
        .nav-link:hover { color: #9d4edd !important; }
        .card { background: #12122a; border: 1px solid #2a2a4a; color: #e0e0e0; }
        .card-header { background: #1a1a3e; border-bottom: 1px solid #2a2a4a; }
        .btn-primary { background: #533483; border-color: #533483; }
        .btn-primary:hover { background: #9d4edd; border-color: #9d4edd; }
        .btn-outline-primary { color: #9d4edd; border-color: #9d4edd; }
        .btn-outline-primary:hover { background: #9d4edd; color: white; }
        .table { color: #e0e0e0; }
        .table-dark { --bs-table-bg: #12122a; }
        .form-control, .form-select { background: #1a1a2e; border-color: #2a2a4a; color: #e0e0e0; }
        .form-control:focus { background: #1a1a2e; border-color: #9d4edd; color: #e0e0e0; box-shadow: 0 0 0 0.2rem rgba(157,78,221,.25); }
        .alert-success { background: #0d2d1a; border-color: #28a745; color: #75e091; }
        .alert-danger { background: #2d0d0d; border-color: #dc3545; color: #f17c7c; }
        footer { background: #0d0d1a; border-top: 1px solid #1a1a3e; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">🎵 MusicStreamer</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Bands" asp-action="Index">Bandas</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Musics" asp-action="Index">Músicas</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Subscriptions" asp-action="Index">Planos</a></li>
                        @if (Context.Session.GetString("JwtToken") != null)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Playlists" asp-action="Index">Playlists</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Favorites" asp-action="Index">Favoritos</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Transactions" asp-action="Index">Transações</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (Context.Session.GetString("JwtToken") != null)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-info">👤 @Context.Session.GetString("UserName")</span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Auth" asp-action="Logout">Sair</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Auth" asp-action="Login">Login</a></li>
                            <li class="nav-item"><a class="nav-link btn btn-sm btn-outline-primary ms-2 px-3" asp-controller="Auth" asp-action="Register">Criar conta</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container py-4">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                ✅ @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                ❌ @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </div>
    <footer class="py-3 mt-5">
        <div class="container text-center text-muted">
            <small>MusicStreamer © 2025 | Projeto Acadêmico INFNET</small>
        </div>
    </footer>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
