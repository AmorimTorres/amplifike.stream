@using System.Text.Json
@{
    ViewData["Title"] = "Favoritos";
    var musics = (JsonElement[])ViewBag.FavoriteMusics;
    var bands = (JsonElement[])ViewBag.FavoriteBands;
}

<h2 class="mb-4">⭐ Meus Favoritos</h2>

<div class="row">
    <div class="col-md-6">
        <h5>🎵 Músicas favoritas</h5>
        @if (!musics.Any())
        {
            <p class="text-muted">Nenhuma música favoritada ainda.</p>
        }
        @foreach (var m in musics)
        {
            var musicId = m.TryGetProperty("musicId", out var mid) ? mid.GetString() : "";
            var title = m.TryGetProperty("title", out var t) ? t.GetString() : "";
            var dur = m.TryGetProperty("formattedDuration", out var d) ? d.GetString() : "";
            var band = m.TryGetProperty("bandName", out var bn) ? bn.GetString() : "";

            <div class="card mb-2">
                <div class="card-body d-flex justify-content-between align-items-center py-2">
                    <div>
                        <strong>@title</strong> <span class="text-muted small">(@band)</span>
                        <span class="badge bg-secondary ms-2">@dur</span>
                    </div>
                    <form asp-controller="Favorites" asp-action="RemoveMusic" method="post">
                        <input type="hidden" name="musicId" value="@musicId" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">✕</button>
                    </form>
                </div>
            </div>
        }
    </div>
    <div class="col-md-6">
        <h5>🎸 Bandas favoritas</h5>
        @if (!bands.Any())
        {
            <p class="text-muted">Nenhuma banda favoritada ainda.</p>
        }
        @foreach (var b in bands)
        {
            var bandId = b.TryGetProperty("bandId", out var bid) ? bid.GetString() : "";
            var name = b.TryGetProperty("name", out var n) ? n.GetString() : "";

            <div class="card mb-2">
                <div class="card-body d-flex justify-content-between align-items-center py-2">
                    <strong>@name</strong>
                    <form asp-controller="Favorites" asp-action="RemoveBand" method="post">
                        <input type="hidden" name="bandId" value="@bandId" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">✕</button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>
