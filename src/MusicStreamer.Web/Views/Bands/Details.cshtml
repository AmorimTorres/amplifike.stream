@using System.Text.Json
@model System.Text.Json.JsonElement
@{
    ViewData["Title"] = "Detalhes da Banda";
    var name = Model.TryGetProperty("name", out var n) ? n.GetString() : "Banda";
    var desc = Model.TryGetProperty("description", out var d) && d.ValueKind != JsonValueKind.Null ? d.GetString() : "";
    var albums = Model.TryGetProperty("albums", out var a) ? a.EnumerateArray() : default;
}

<div class="mb-4">
    <a asp-controller="Bands" asp-action="Index" class="btn btn-sm btn-outline-secondary mb-3">← Voltar</a>
    <h2>🎸 @name</h2>
    <p class="text-muted">@desc</p>
</div>

<h5>Álbuns</h5>
<div class="row g-3">
    @foreach (var album in albums)
    {
        var title = album.TryGetProperty("title", out var t) ? t.GetString() : "Sem título";
        var year = album.TryGetProperty("releaseYear", out var y) ? y.GetInt32() : 0;
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h6>@title</h6>
                    <span class="text-muted small">@year</span>
                </div>
            </div>
        </div>
    }
</div>
