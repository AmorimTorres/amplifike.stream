@{
    ViewData["Title"] = "Entrar";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card">
            <div class="card-header">
                <h4 class="mb-0">🔐 Entrar</h4>
            </div>
            <div class="card-body">
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }
                <form method="post">
                    <div class="mb-3">
                        <label class="form-label">E-mail</label>
                        <input type="email" name="email" class="form-control" placeholder="seu@email.com" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Senha</label>
                        <input type="password" name="password" class="form-control" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Entrar</button>
                </form>
                <hr />
                <p class="text-center text-muted mb-2">Conta admin: <code>admin@musicstreamer.com</code> / <code>Admin@123</code></p>
                <p class="text-center text-muted mb-0">
                    Não tem conta? <a asp-controller="Auth" asp-action="Register" style="color:#9d4edd;">Criar conta</a>
                </p>
            </div>
        </div>
    </div>
</div>
